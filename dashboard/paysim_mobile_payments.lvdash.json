{
 "datasets": [
  {
   "name": "kpis",
   "displayName": "KPIs",
   "queryLines": [
    "SELECT * FROM workspace.paysim.gold_kpis\n"
   ]
  },
  {
   "name": "types",
   "displayName": "Type mix",
   "queryLines": [
    "SELECT type, 'Share of transactions (%)' AS measure, pct_txns AS pct FROM workspace.paysim.gold_type_mix\n",
    "UNION ALL SELECT type, 'Share of value (%)', pct_value FROM workspace.paysim.gold_type_mix\n"
   ]
  },
  {
   "name": "hourly",
   "displayName": "Hourly",
   "queryLines": [
    "SELECT hour_of_day, avg_txns_per_day, fraud_rate_pct, fraud_n FROM workspace.paysim.gold_hourly\n"
   ]
  },
  {
   "name": "ret",
   "displayName": "Retention",
   "queryLines": [
    "SELECT concat('Week ', cohort_week, ' cohort') AS cohort, weeks_since, retention_pct\n",
    "FROM workspace.paysim.gold_cohort_retention WHERE weeks_since > 0 AND cohort_week <= 3\n"
   ]
  },
  {
   "name": "rules",
   "displayName": "Fraud rules",
   "queryLines": [
    "WITH r AS (SELECT CASE WHEN rule LIKE 'Built-in%' THEN '1 Built-in flag'\n",
    "                          WHEN rule LIKE '%OR night%' THEN '3 Drain + night rule'\n",
    "                          ELSE '2 Drain rule' END AS rule, recall_pct, precision_pct FROM workspace.paysim.gold_fraud_rules)\n",
    "SELECT rule, 'Recall (%)' AS metric, recall_pct AS pct FROM r\n",
    "UNION ALL SELECT rule, 'Precision (%)', precision_pct FROM r\n"
   ]
  }
 ],
